# Data files - never commit datasets, only the folder structure
data/**
!data/**/
!data/**/.gitkeep

# ...except hand-written override files, which are decisions rather than data and
# would otherwise have to be re-derived by hand on every machine.
!data/manual/*.csv

# ...and except the two things the deployed report reads. Everything else in data/ is
# build output that can be rebuilt from source; these two cannot.
#
# The prediction archive is the record of what the model said before each round was
# played. It is the one artefact here that cannot be regenerated - re-running a past
# round answers a different question - so keeping it on a single laptop was a bad idea
# quite apart from deployment.
!data/final/rounds/*.json
!data/final/rounds/**/*.json

# matches.parquet is rebuildable, but the report needs final scores to say whether a
# prediction was right, and 140 KB is a cheap price for a page that works on a clean
# clone. Committed whole rather than as a trimmed copy, because a second file holding
# the same results is a second file that can disagree with the first.
!data/processed/matches.parquet

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
dist/
build/

# Tooling caches
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# Model artefacts
AutogluonModels/
models/*.pkl

# Secrets
.env

# Claude Code - local permissions are per-machine
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Chrome profile written by tools/screenshots.py, if it is ever pointed here
chrome-profile/
