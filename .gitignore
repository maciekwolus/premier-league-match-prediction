# Data files - never commit datasets, only the folder structure
data/**
!data/**/
!data/**/.gitkeep

# ...except hand-written override files, which are decisions rather than data and
# would otherwise have to be re-derived by hand on every machine.
!data/manual/*.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
dist/
build/

# Tooling caches
.ruff_cache/
.pytest_cache/
.ipynb_checkpoints/

# Model artefacts
AutogluonModels/
models/*.pkl

# Secrets
.env

# Claude Code - local permissions are per-machine
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
